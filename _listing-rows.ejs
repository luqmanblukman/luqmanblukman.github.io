<% /* Keep each <li> on one line: Quarto reads template output as markdown, and line breaks inside an item wrap it in a <p>, which breaks the grid. */ %>
<ul class="rows">
<% if (items.length === 0) { %><li class="empty">First review in progress. See the <a href="/reviews/reading-list.html">reading list</a> for what's coming.</li>
<% } %><% for (const item of items) { %><li <%= metadataAttrs(item) %>><span class="when"><%= item.date %></span><a class="t" href="<%- item.path %>"><%= item.title %></a><span class="tags"><% for (const c of (item.categories || []).filter(c => c !== 'paper-review').slice(0, 2)) { %><span class="tag"><%= c %></span><% } %></span><% if (item.original) { %><span class="sub">Originally published on <%= item.original %></span><% } else if (item.venue) { %><span class="sub"><%= item.venue %></span><% } %></li>
<% } %>
</ul>
